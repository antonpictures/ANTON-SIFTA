#!/usr/bin/env python3
"""Capture a public web page into Alice's web-capture body ledger."""
from __future__ import annotations

import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
if str(REPO) not in sys.path:
    sys.path.insert(0, str(REPO))

from System.swarm_kimi_webbridge_bridge import capture_url, summarize_capture


def main(argv: list[str]) -> int:
    if not argv:
        print("usage: alice-web-capture <url> [owner text...]")
        return 2
    url = argv[0]
    owner_text = " ".join(argv[1:]).strip() or f"alice-web-capture {url}"
    row = capture_url(url, owner_text=owner_text)
    print(summarize_capture(row))
    return 0 if row.get("ok") else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
