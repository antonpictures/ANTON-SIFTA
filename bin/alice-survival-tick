#!/usr/bin/env python3
"""One-shot MacBook survival swimmer tick."""

from __future__ import annotations

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from System.swarm_macbook_survival_swimmer import format_owner_reply, sample


def main() -> int:
    row = sample(write=True, force=True, source="bin/alice-survival-tick")
    print(format_owner_reply(row))
    print(
        json.dumps(
            {
                "truth_label": row.get("truth_label"),
                "receipt_id": row.get("receipt_id"),
                "survival_band": (row.get("decision") or {}).get("survival_band"),
                "reasons": (row.get("decision") or {}).get("reasons"),
                "write_status": row.get("write_status"),
            },
            ensure_ascii=False,
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
