diff --git a/UI/Qt/LocationEdit.cpp b/UI/Qt/LocationEdit.cpp
index 64f8f2e673f..796e3a541a0 100644
--- a/UI/Qt/LocationEdit.cpp
+++ b/UI/Qt/LocationEdit.cpp
@@ -861,7 +861,11 @@ void LocationEdit::contextMenuEvent(QContextMenuEvent* event)
     if (!added_paste_and_go_action)
         menu->addAction(paste_and_go_action);
 
